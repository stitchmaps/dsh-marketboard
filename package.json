{
  "name": "dsh-marketboard",
  "version": "0.1.0",
  "description": "DeepSeek Harness 行情看板插件：A股/港股/美股、外汇（含交叉盘）、商品期货与全球指数的实时行情列表，自选持久化、搜索添加、自动刷新，无图表。",
  "icon": "icon.svg",
  "author": "gary",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "icon.svg",
    "lib/client.js",
    "lib/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "market",
    "quote",
    "watchlist",
    "stock",
    "forex",
    "futures",
    "ui"
  ],
  "license": "MIT"
}
